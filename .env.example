# Supabase Configuration
# Required: Supabase Project URL and Public Publishable / Anon Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: Supabase Secret Key (Server-Only, never exposed to client)
# Only needed if executing privileged administrative operations that bypass RLS
# SUPABASE_SECRET_KEY=your-supabase-secret-key

# AI & Search API Keys (Server-Only, never exposed to client)
GEMINI_API_KEY=your-gemini-api-key
TAVILY_API_KEY=your-tavily-api-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
