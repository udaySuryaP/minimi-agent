# Supabase Configuration
# Required: Supabase Project URL and Public Publishable / Anon Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: Supabase Secret Key (Server-Only, never exposed to client)
# Only needed if executing privileged administrative operations that bypass RLS
# SUPABASE_SECRET_KEY=your-supabase-secret-key

# AI & Search API Keys (Server-Only, never exposed to client)
GEMINI_API_KEY=your-gemini-api-key
# OpenRouter is optional. When used, set an explicit model; do not rely on automatic free routing.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=your-explicit-openrouter-model
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_CLASSIFICATION_MODEL=
OPENROUTER_EXTRACTION_MODEL=
OPENROUTER_ANSWER_MODEL=
OPENROUTER_VERIFICATION_MODEL=
OPENROUTER_EXTRACTION_TIMEOUT_MS=15000
TAVILY_API_KEY=your-tavily-api-key
AGENT_MAX_REQUEST_BYTES=16384
AGENT_MAX_SEARCH_CALLS=8
AGENT_MAX_RESULTS_PER_CALL=5
AGENT_SEARCH_CALL_TIMEOUT_MS=8000
AGENT_SEARCH_TOTAL_TIMEOUT_MS=30000

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
